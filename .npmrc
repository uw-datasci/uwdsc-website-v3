# Route the @uw-datasci scope to the GitHub Packages registry.
# GitHub Packages requires the npm scope to match the GitHub org login.
@uw-datasci:registry=https://npm.pkg.github.com

# Auth is NOT configured here: pnpm 12+ ignores `${ENV}` expansion in project-level
# registry credentials. Locally, add this line to your user-level ~/.npmrc:
#   //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# and export NODE_AUTH_TOKEN=<a classic GitHub PAT with read:packages> in your shell profile.
# In CI, `actions/setup-node` (with `registry-url`) writes the credentials for you.
# On Vercel, each app's `vercel.json` installCommand writes them to ~/.npmrc from the
# project's NODE_AUTH_TOKEN env var.
