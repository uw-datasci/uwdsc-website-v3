{
  "$schema": "https://v2-11-5.turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["NEXT_RUNTIME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "GITHUB_TOKEN",
        "FOUNDRY_WORKFLOW_ID",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_CAMPAIGN_SEGMENT_ID",
        "RESEND_WEBHOOK_SECRET",
        "DISCORD_INVITE_URL",
        "NEXT_PUBLIC_AUTH_COOKIE_DOMAIN",
        "FEED_HASH_SALT",
        "SUPPORT_DISCORD_WEBHOOK_URL",
        "RAFT_APP_NAME",
        "RAFT_DATABASE_URL",
        "DISCORD_APPLICATION_ID",
        "DISCORD_PUBLIC_KEY",
        "DISCORD_BOT_TOKEN",
        "DISCORD_GUILD_ID",
        "DISCORD_EXEC_ROLE_ID",
        "ANTHROPIC_API_KEY"
      ]
    },
    "lint": { "dependsOn": ["^lint"] },
    "check-types": { "dependsOn": ["^check-types"] },
    "dev": { "cache": false, "persistent": true }
  }
}
